{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx local-server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js && esbuild local-server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/lib/subscription.test.ts src/lib/i18n.test.ts src/lib/ai-models.test.ts src/lib/themes.test.ts src/lib/qr-tables.test.ts scripts/vercel-api.test.ts passcodes.test.ts",
    "test:backend": "tsx scripts/smoke-backend.ts",
    "migrate:firebase": "tsx scripts/migrate-firebase-to-supabase.ts",
    "create:admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@supabase/supabase-js": "^2.76.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-qr-code": "^2.0.21",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-admin": "^13.10.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "uuid": "^11.1.1"
  }
}
