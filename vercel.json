{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "functions": { "api/index.ts": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/:route*", "destination": "/api/index?route=:route*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
