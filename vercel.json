{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "redirects": [
    { "source": "/app", "destination": "https://rest.ordova.cc/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:route*", "destination": "/api/index?route=:route*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
