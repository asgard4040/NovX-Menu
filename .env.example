WEB_PUSH_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
CRON_SECRET=
GEMINI_API_KEY=
OPENAI_API_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Required only while importing existing Firebase data. Remove after validation.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_DATABASE_ID=
APP_URL=
