VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key

# Server/migration only. Never prefix this with VITE_ or expose it to browsers.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only: 64 hexadecimal characters (32 random bytes). Keep stable or stored passcodes cannot be read.
PASSCODE_SECRET=

VITE_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
CRON_SECRET=
GEMINI_API_KEY=
OPENAI_API_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Required only while importing existing Firebase data. Remove after validation.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_DATABASE_ID=
APP_URL=
# Server-only Wayl merchant token. Use WAYL_ENV=test for sandbox checkouts.
WAYL_API_KEY=
WAYL_ENV=test
# In test mode, only this restaurant can start or apply sandbox payments.
WAYL_TEST_RESTAURANT_ID=

# WhatsApp AI ordering (server only)
# Manual connections are the default. Set this to true to show Meta Embedded Signup.
WHATSAPP_EMBEDDED_SIGNUP_ENABLED=false
# Defaults to the ORDOVA owner dashboard. Use a public HTTPS origin for staging.
WHATSAPP_WEBHOOK_ORIGIN=
# Only required for the optional Embedded Signup flow and its legacy webhook.
WHATSAPP_META_APP_ID=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_SIGNUP_CONFIG_ID=
WHATSAPP_GRAPH_VERSION=v27.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Generate 32 random bytes as base64url and keep the key stable across releases.
WHATSAPP_CREDENTIAL_KEY=
# Use the same secret in Supabase Vault for the WhatsApp worker schedule.
WHATSAPP_WORKER_SECRET=
# Falls back to OPENAI_API_KEY when empty.
WHATSAPP_OPENAI_API_KEY=
WHATSAPP_OPENAI_MODEL=gpt-6-luna
# Optional cost estimate. Set both rates for the selected model in USD per 1M tokens.
WHATSAPP_OPENAI_INPUT_USD_PER_MILLION=
WHATSAPP_OPENAI_OUTPUT_USD_PER_MILLION=
WHATSAPP_OPENAI_CACHED_INPUT_USD_PER_MILLION=
# Bounds include reasoning and the action tool arguments. Valid range 800–4000.
WHATSAPP_OPENAI_MAX_OUTPUT_TOKENS=1800
# Gupshup platform-fee estimate only; excludes Meta fees and tax.
WHATSAPP_GUPSHUP_TEXT_USD_PER_MESSAGE=0.001

# GPT-6 Luna classifier: none (default, lower latency) or low.
WHATSAPP_OPENAI_REASONING_EFFORT=none
